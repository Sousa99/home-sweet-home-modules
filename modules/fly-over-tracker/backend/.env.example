# Backend environment configuration
# Copy to `.env` (same directory) and adjust as needed. Existing environment
# variables always win over this file. Full reference: docs/configuration.md.

# --- Data source (OPTIONAL, shown with defaults) ---
# The feeds use the free, open adsb.lol API (no credentials required). A
# descriptive User-Agent is always sent (adsb.lol rejects generic ones).
# ADSB_BASE_URL=https://api.adsb.lol
# ADSB_ROUTE_BASE_URL=https://vrs-standing-data.adsb.lol
# FEED=adsb                    # or "mock" for deterministic offline data
# FEED_TIMEOUT_MS=8000

# --- Server (OPTIONAL, shown with defaults) ---
# HOST=127.0.0.1
# HTTP_PORT=3000
# MCP_PORT=3001
# MAX_RADIUS_KM=463            # capped by the adsb.lol /v2/point 250 nm limit
# LOG_LEVEL=debug              # trace|debug|info|warn|error|fatal|silent
# NODE_ENV=development

# --- Retry / backoff on 429 (OPTIONAL) ---
# RETRY_ATTEMPTS=3
# RETRY_DEFAULT_MS=2000
# RETRY_CAP_MS=10000

# --- Route cache tuning (OPTIONAL) ---
# DEST_CACHE_TTL_MS=600000
# DEST_NEGATIVE_TTL_MS=60000