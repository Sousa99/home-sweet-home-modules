# Backend environment configuration
# Copy to `.env` (same directory) and fill in, or export in the shell / set in
# your container or orchestrator. Existing environment variables always win
# over this file. Full reference: docs/configuration.md.

# --- OpenSky access (OPTIONAL unless you want destination enrichment) ---
# Create a free account at https://opensky-network.org, open the Account page,
# and create an "API client" to obtain these two values. OAuth2 client
# credentials are the only supported auth (basic auth was removed 2026-03-18).
# Without them the backend runs on the anonymous tier and reports
# `destinationEnrichment: "unavailable"`.
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# --- Server (OPTIONAL, shown with defaults) ---
# HOST=127.0.0.1
# HTTP_PORT=3000
# MCP_PORT=3001
# MAX_RADIUS_KM=500
# FEED=opensky            # or "mock" for deterministic offline data
# FEED_TIMEOUT_MS=8000
# LOG_LEVEL=debug         # trace|debug|info|warn|error|fatal|silent
# NODE_ENV=development

# --- OpenSky feed (OPTIONAL) ---
# OPENSKY_BASE_URL=https://opensky-network.org
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# --- Retry / backoff on 429 (OPTIONAL) ---
# RETRY_ATTEMPTS=3
# RETRY_DEFAULT_MS=2000
# RETRY_CAP_MS=10000

# --- Destination enrichment tuning (OPTIONAL) ---
# DEST_WINDOW_H=24
# DEST_CONCURRENCY=8
# DEST_CACHE_TTL_MS=600000
# DEST_NEGATIVE_TTL_MS=60000