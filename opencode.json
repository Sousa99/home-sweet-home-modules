{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "default,actions"
      }
    }
  },
  "permission": {
    "github_*": "deny",
    "bash": {
      "*": "allow",
      "git": "deny",
      "git *": "deny",
      "gh": "deny",
      "gh *": "deny"
    }
  }
}
