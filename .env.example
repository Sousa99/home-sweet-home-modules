# Home Sweet Home — Docker Compose environment overrides.
# Copy to `.env` (gitignored) to override defaults. The stack works without this file:
# every value below is already the compose default.

# Host port overrides (defaults match specs/004-local-setup-standardization/contracts/ports.md)
# HSH_BUS_CATCHER_REST_PORT=3100
# HSH_BUS_CATCHER_MCP_PORT=3200
# HSH_BUS_CATCHER_SPA_PORT=3300
# HSH_BUS_CATCHER_STORYBOOK_PORT=3400
# HSH_FLY_OVER_TRACKER_REST_PORT=3101
# HSH_FLY_OVER_TRACKER_MCP_PORT=3201
# HSH_FLY_OVER_TRACKER_SPA_PORT=3301
# HSH_FLY_OVER_TRACKER_STORYBOOK_PORT=3401
# HSH_PROCRASTINATOR_TRACKER_REST_PORT=3102
# HSH_PROCRASTINATOR_TRACKER_MCP_PORT=3202
# HSH_PROCRASTINATOR_TRACKER_SPA_PORT=3302
# HSH_PROCRASTINATOR_TRACKER_STORYBOOK_PORT=3402
# HSH_CURRENT_TIME_SPA_PORT=3303
# HSH_CURRENT_TIME_STORYBOOK_PORT=3403

# Backend upstream for each module's SPA/Storybook nginx /api proxy
# (defaults point at the module's backend service inside the compose network)
# HSH_BUS_CATCHER_UPSTREAM=bus-catcher-backend:3000
# HSH_FLY_OVER_TRACKER_UPSTREAM=fly-over-tracker-backend:3000
# HSH_PROCRASTINATOR_TRACKER_UPSTREAM=procrastinator-tracker-backend:3000

# If a private @sousa99 package is ever required at build time, provide the GitHub
# token: pass the build secret `npm_token` (e.g. docker compose --build build --secret
# id=npm_token,src=./.secrets/npm_token). The module Dockerfiles build without it today.